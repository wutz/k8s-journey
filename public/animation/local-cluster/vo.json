[{"s":0,"a":3.2,"d":3.41,"text":"几十秒建好，搞坏了随时重建。","f":"e30eef88e8.mp3","h":"e30eef88e8","r":0},{"s":1,"a":0.6,"d":4.44,"text":"本地集群工具有 kind、minikube 和 k3d。","f":"d15f30f641.mp3","h":"d15f30f641","r":0},{"s":1,"a":5.6,"d":3.89,"text":"kind 把每个节点都跑成一个 Docker 容器，","f":"ff0006f8a1.mp3","h":"ff0006f8a1","r":0},{"s":1,"a":11,"d":4.34,"text":"apiserver 端口映射到本机，kubectl 直连。","f":"c8f045609f.mp3","h":"c8f045609f","r":0},{"s":2,"a":0.6,"d":3.79,"text":"一份 kind-config.yaml，声明 3 个节点。","f":"782b611539.mp3","h":"782b611539","r":0},{"s":2,"a":5.6,"d":4.08,"text":"kind create 一条命令，几十秒建好集群，","f":"b16ce97ca6.mp3","h":"b16ce97ca6","r":0},{"s":2,"a":11,"d":3.94,"text":"上下文自动切换，3 个节点都 Ready。","f":"5c13fb0b1d.mp3","h":"5c13fb0b1d","r":0},{"s":3,"a":0.6,"d":4.13,"text":"控制平面组件，都以静态 Pod 形式运行；","f":"b1511d0303.mp3","h":"b1511d0303","r":0},{"s":3,"a":5.6,"d":3.86,"text":"kube-proxy 和 kindnet，每个节点一个；","f":"ccb612c425.mp3","h":"ccb612c425","r":0},{"s":3,"a":11,"d":3.74,"text":"kubelet 和 containerd 则是系统进程。","f":"a1e7c21b7c.mp3","h":"a1e7c21b7c","r":0},{"s":4,"a":0.6,"d":3.26,"text":"一条命令，部署 2 个 nginx 副本。","f":"624aec4232.mp3","h":"624aec4232","r":0},{"s":4,"a":5.6,"d":4.18,"text":"控制平面有污点，Pod 只落在两个 worker 上。","f":"56a595b3af.mp3","h":"56a595b3af","r":0},{"s":4,"a":11,"d":3.74,"text":"删掉一个，控制循环马上补一个新的。","f":"d6608e14bb.mp3","h":"d6608e14bb","r":0},{"s":5,"a":0.6,"d":3.79,"text":"expose 给这组 Pod 一个稳定的 Service；","f":"8f589bf48c.mp3","h":"8f589bf48c","r":0},{"s":5,"a":5.6,"d":3.96,"text":"port-forward 转发到本机，curl 就能访问。","f":"b32d3494c9.mp3","h":"b32d3494c9","r":0},{"s":5,"a":11,"d":3.38,"text":"但它只连一个 Pod，只适合调试。","f":"295cfc3214.mp3","h":"295cfc3214","r":0},{"s":6,"a":0.8,"d":3.67,"text":"小结：本地集群，随建随删。","f":"1a44a4bf3a.mp3","h":"1a44a4bf3a","r":0},{"s":6,"a":5.6,"d":4.13,"text":"下一课，学 kubectl 与声明式 API。","f":"fc8349636b.mp3","h":"fc8349636b","r":0}]
