[{"s":0,"a":3.2,"d":4.13,"text":"多机训练：编排之外，网络决定速度。","f":"4f02ecc254.mp3","h":"4f02ecc254","r":0},{"s":1,"a":0.6,"d":4.03,"text":"管理员写 Runtime，用户只写 TrainJob。","f":"91c3b2c2c2.mp3","h":"91c3b2c2c2","r":0},{"s":1,"a":5.6,"d":5.04,"text":"JobSet 建出一组 Pod，注入 rank 和主节点地址。","f":"6f073526e7.mp3","h":"6f073526e7","r":0},{"s":1,"a":11,"d":3.38,"text":"一个 worker 失败，整组一起重启。","f":"9935b0ca75.mp3","h":"9935b0ca75","r":0},{"s":2,"a":0.6,"d":5.11,"text":"普通 TCP 要经过主机内存和内核，反复拷贝。","f":"57cb6ce4c5.mp3","h":"57cb6ce4c5","r":0},{"s":2,"a":6.8,"d":4.42,"text":"GPUDirect RDMA：网卡直接读写显存。","f":"750a868449.mp3","h":"750a868449","r":0},{"s":2,"a":11.8,"d":3.91,"text":"承载 RDMA 的有 InfiniBand 和 RoCE。","f":"68f6d3e123.mp3","h":"68f6d3e123","r":0},{"s":3,"a":0.6,"d":4.39,"text":"NicClusterPolicy 部署 RDMA 设备插件。","f":"76fc7ce111.mp3","h":"76fc7ce111","r":0},{"s":3,"a":5.6,"d":4.63,"text":"hostNetwork 最简单，但一台只能跑一个作业。","f":"24ff902c27.mp3","h":"24ff902c27","r":0},{"s":3,"a":11,"d":4.49,"text":"macvlan 让每个 Pod 有独立的 RDMA IP。","f":"d73f95c69b.mp3","h":"d73f95c69b","r":0},{"s":4,"a":0.6,"d":4.37,"text":"用 nccl-tests 跑两机十六卡 AllReduce。","f":"3f601c8d45.mp3","h":"3f601c8d45","r":0},{"s":4,"a":5.8,"d":4.78,"text":"看大消息的 busbw，能直接比硬件带宽。","f":"aac25760a8.mp3","h":"aac25760a8","r":6},{"s":4,"a":10.8,"d":5.28,"text":"348.8 比 400，约 87%，属于可接受。","f":"a550cb84ed.mp3","h":"a550cb84ed","r":5},{"s":5,"a":0.6,"d":4.54,"text":"通信最密的 TP 留在机内，走 NVLink。","f":"c0abdc4f88.mp3","h":"c0abdc4f88","r":0},{"s":5,"a":5.6,"d":4.3,"text":"流水线并行 PP 跨节点，走 RDMA 网络。","f":"744d00dd93.mp3","h":"744d00dd93","r":0},{"s":5,"a":10.8,"d":5.28,"text":"剩下的是数据并行：总卡数除以 TP 乘 PP。","f":"4a1312c79c.mp3","h":"4a1312c79c","r":0},{"s":6,"a":0.8,"d":4.51,"text":"小结：编排靠 Trainer，速度靠 RDMA。","f":"1ce3791d50.mp3","h":"1ce3791d50","r":4},{"s":6,"a":5.6,"d":2.98,"text":"下一课，大模型推理服务。","f":"4498d2ab75.mp3","h":"4498d2ab75","r":0}]
