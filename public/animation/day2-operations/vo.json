[{"s":0,"a":3.2,"d":4.49,"text":"Day-2：上线之后的几年，集群要一直健康。","f":"746ec7b9e3.mp3","h":"746ec7b9e3","r":0},{"s":1,"a":0.5,"d":3.5,"text":"升级有三层版本规则，同时生效。","f":"42920c794b.mp3","h":"42920c794b","r":8},{"s":1,"a":4.2,"d":4.2,"text":"1.33 不能直接到 1.35，Kubespray 同理。","f":"9a3e8ed3c6.mp3","h":"9a3e8ed3c6","r":15},{"s":1,"a":8.6,"d":3.6,"text":"etcd 先停在 3.5.26，再升 3.6。","f":"a9968b65c0.mp3","h":"a9968b65c0","r":20},{"s":1,"a":12.4,"d":4.46,"text":"kubelet 不能比 apiserver 新，先升控制平面。","f":"2feec06c8f.mp3","h":"2feec06c8f","r":0},{"s":2,"a":0.6,"d":3.79,"text":"生产上分阶段升级，每步确认健康。","f":"fb83829e05.mp3","h":"fb83829e05","r":6},{"s":2,"a":4.6,"d":3.98,"text":"第一步只升 etcd 和控制平面，逐台进行。","f":"5d737aed5a.mp3","h":"5d737aed5a","r":7},{"s":2,"a":8.8,"d":3.58,"text":"第二步分批升工作节点，每批 20%。","f":"4b62b7b1aa.mp3","h":"4b62b7b1aa","r":7},{"s":2,"a":12.6,"d":3.31,"text":"每台先 drain，升完再恢复调度。","f":"156ef8f95e.mp3","h":"156ef8f95e","r":0},{"s":3,"a":0.6,"d":3.29,"text":"drain 先 cordon，再逐个驱逐 Pod。","f":"0ed8884b5f.mp3","h":"0ed8884b5f","r":0},{"s":3,"a":4.4,"d":4.66,"text":"PDB 要求至少 2 个可用，一次只能驱逐一个。","f":"7400346e7f.mp3","h":"7400346e7f","r":0},{"s":3,"a":9.4,"d":4.01,"text":"minAvailable 等于副本数，drain 就永远卡住。","f":"3bb19eab09.mp3","h":"3bb19eab09","r":11},{"s":3,"a":13.6,"d":3.53,"text":"PDB 要留余量，维护完再 uncordon。","f":"2fd2136f06.mp3","h":"2fd2136f06","r":12},{"s":4,"a":0.6,"d":3.86,"text":"先加载 /etc/etcd.env 里的连接参数。","f":"989cd0c2f9.mp3","h":"989cd0c2f9","r":0},{"s":4,"a":4.6,"d":3.26,"text":"snapshot save 在一个健康成员上做。","f":"1f4577d217.mp3","h":"1f4577d217","r":0},{"s":4,"a":8.8,"d":3,"text":"备份要拷到集群外，保留多份。","f":"629090915c.mp3","h":"629090915c","r":11},{"s":4,"a":12,"d":3.14,"text":"没恢复过的备份，不算备份。","f":"091033b0f1.mp3","h":"091033b0f1","r":0},{"s":5,"a":0.6,"d":3.77,"text":"etcd 数据库超过配额，就拒绝一切写入。","f":"2b1754ebd1.mp3","h":"2b1754ebd1","r":10},{"s":5,"a":4.6,"d":3.96,"text":"compact 丢旧版本，defrag 才还空间。","f":"058f18abe7.mp3","h":"058f18abe7","r":0},{"s":5,"a":9,"d":3.6,"text":"defrag 逐个成员，最后才是 leader。","f":"e4c22a4151.mp3","h":"e4c22a4151","r":0},{"s":5,"a":13,"d":3.24,"text":"最后 alarm disarm，写入恢复。","f":"8a4fedf31e.mp3","h":"8a4fedf31e","r":0},{"s":6,"a":0.8,"d":4.61,"text":"小结：升级前先备份，每一步确认健康再继续。","f":"8ec7f662d7.mp3","h":"8ec7f662d7","r":11},{"s":6,"a":5.6,"d":3.05,"text":"下一课，故障排查方法论。","f":"339223d4df.mp3","h":"339223d4df","r":0}]
