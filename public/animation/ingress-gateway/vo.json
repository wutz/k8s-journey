[{"s":0,"a":3.2,"d":4.42,"text":"七层入口：从 Ingress 走向 Gateway API。","f":"5ee6238a1b.mp3","h":"5ee6238a1b","r":0},{"s":1,"a":0.6,"d":4.78,"text":"对外服务要按域名、路径分流，统一 HTTPS。","f":"1dd333625b.mp3","h":"1dd333625b","r":14},{"s":1,"a":5.6,"d":4.8,"text":"给每个服务开 LB，既浪费 IP，又只懂四层。","f":"e9bf28a6e7.mp3","h":"e9bf28a6e7","r":13},{"s":1,"a":10.6,"d":5.45,"text":"K8s 只定义 API，真正转发的是入口控制器。","f":"b8e7771da1.mp3","h":"b8e7771da1","r":7},{"s":2,"a":0.6,"d":4.39,"text":"Ingress 按 Host 和 Path 把请求分给 Service。","f":"469de594fa.mp3","h":"469de594fa","r":0},{"s":2,"a":5.8,"d":5.16,"text":"Prefix 按路径段匹配：/api 不匹配 /apis。","f":"86a9f030a2.mp3","h":"86a9f030a2","r":11},{"s":2,"a":11.2,"d":4.25,"text":"ingressClassName 指定由哪个控制器处理。","f":"437f9d0a1f.mp3","h":"437f9d0a1f","r":0},{"s":3,"a":0.6,"d":4.8,"text":"重写、限流、金丝雀，Ingress 全靠注解。","f":"42c1436c87.mp3","h":"42c1436c87","r":0},{"s":3,"a":5.6,"d":4.73,"text":"注解各家不同，不可移植，拼错也静默失效。","f":"09e7374a5d.mp3","h":"09e7374a5d","r":0},{"s":3,"a":10.8,"d":5.02,"text":"ingress-nginx 已退役，新项目优先选 Gateway API。","f":"e58ee02179.mp3","h":"e58ee02179","r":0},{"s":4,"a":0.6,"d":4.42,"text":"Gateway API 把入口的职责拆给三类角色。","f":"b6d543991b.mp3","h":"b6d543991b","r":0},{"s":4,"a":5.6,"d":4.92,"text":"Class 选实现，Gateway 定监听，Route 管路由。","f":"6c3450ec33.mp3","h":"6c3450ec33","r":0},{"s":4,"a":10.8,"d":4.44,"text":"匹配、切流、多协议，全是标准字段。","f":"826f47b7b6.mp3","h":"826f47b7b6","r":0},{"s":5,"a":0.6,"d":4.13,"text":"HTTPRoute 用 weight 字段按比例切流。","f":"449ed6423c.mp3","h":"449ed6423c","r":0},{"s":5,"a":5.6,"d":4.66,"text":"带 X-Canary 请求头的测试流量，全部去 v2。","f":"76da71ced0.mp3","h":"76da71ced0","r":0},{"s":5,"a":11,"d":4.51,"text":"逐步调权重直到 0/100，发布就完成了。","f":"a3c21ff486.mp3","h":"a3c21ff486","r":0},{"s":6,"a":0.8,"d":4.37,"text":"小结：新项目的七层入口，优先 Gateway API。","f":"52902fb536.mp3","h":"52902fb536","r":12},{"s":6,"a":5.4,"d":4.42,"text":"下一课，学习调度：亲和、污点与拓扑。","f":"e0d4d16867.mp3","h":"e0d4d16867","r":0}]
