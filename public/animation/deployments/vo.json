[{"s":0,"a":3.2,"d":4.92,"text":"Deployment：让应用可扩缩、可升级、可回滚。","f":"3098a2fc42.mp3","h":"3098a2fc42","r":0},{"s":1,"a":0.6,"d":4.08,"text":"ReplicaSet 只做一件事：保持副本数。","f":"def393538f.mp3","h":"def393538f","r":0},{"s":1,"a":5.6,"d":4.37,"text":"它靠标签认领 Pod，改掉标签就被摘出去。","f":"e86be7d818.mp3","h":"e86be7d818","r":0},{"s":1,"a":10.8,"d":5.02,"text":"RS 不会更新已有 Pod，所以要用 Deployment。","f":"60ab6fe9d5.mp3","h":"60ab6fe9d5","r":0},{"s":2,"a":0.6,"d":4.75,"text":"Deployment 管 RS，RS 再管 Pod。","f":"b7e440ea9d.mp3","h":"b7e440ea9d","r":5},{"s":2,"a":5.6,"d":4.94,"text":"哈希来自 Pod 模板，模板一变就换新 RS。","f":"aa83261dd2.mp3","h":"aa83261dd2","r":10},{"s":2,"a":10.8,"d":4.01,"text":"三列状态：就绪、已更新、可用。","f":"b93b5861b8.mp3","h":"b93b5861b8","r":0},{"s":3,"a":0.6,"d":3.7,"text":"改镜像，Deployment 开始滚动更新。","f":"982433a310.mp3","h":"982433a310","r":0},{"s":3,"a":5.2,"d":5.35,"text":"多 1 个、少 0 个：先加后减，容量不降。","f":"87c6cf6bfa.mp3","h":"87c6cf6bfa","r":0},{"s":3,"a":11,"d":4.85,"text":"新 RS 满 4 个，旧 RS 缩到 0，留作回滚。","f":"1793eefc19.mp3","h":"1793eefc19","r":0},{"s":4,"a":0.6,"d":3.1,"text":"rollout history 记录每一次发布。","f":"a7051bf1cc.mp3","h":"a7051bf1cc","r":0},{"s":4,"a":5.4,"d":3.55,"text":"坏镜像拉不下来，旧 Pod 一个没删。","f":"666a51bc7b.mp3","h":"666a51bc7b","r":0},{"s":4,"a":10.8,"d":4.32,"text":"undo 一键回滚，Git 里也要 revert。","f":"a5e03cf0fa.mp3","h":"a5e03cf0fa","r":0},{"s":5,"a":0.6,"d":4.06,"text":"Recreate 先全删再重建，会中断服务。","f":"8a389f9613.mp3","h":"8a389f9613","r":0},{"s":5,"a":5.6,"d":3.79,"text":"蓝绿：改 Service 选择器，一步切换。","f":"7de399a3e4.mp3","h":"7de399a3e4","r":0},{"s":5,"a":10.8,"d":4.54,"text":"金丝雀：按副本比例，约一成流量试新版。","f":"93b5086888.mp3","h":"93b5086888","r":0},{"s":6,"a":0.8,"d":4.61,"text":"小结：日常用 Deployment，不直接用 RS。","f":"dce3fdb5fd.mp3","h":"dce3fdb5fd","r":12},{"s":6,"a":5.6,"d":3.84,"text":"下一课，用 Service 给 Pod 稳定的入口。","f":"ab9dc0e8b2.mp3","h":"ab9dc0e8b2","r":0}]
