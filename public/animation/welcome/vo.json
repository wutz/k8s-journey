[{"s":0,"a":3.2,"d":4.27,"text":"一条从零走到生产的 K8s 学习路线。","f":"8b9bc95093.mp3","h":"8b9bc95093","r":0},{"s":1,"a":0.6,"d":3.84,"text":"K8s 知识点多，而且彼此交织。","f":"505ed1479b.mp3","h":"505ed1479b","r":0},{"s":1,"a":5.2,"d":3.91,"text":"想懂 Service，得先懂 Pod 和标签。","f":"ce46a35891.mp3","h":"ce46a35891","r":0},{"s":1,"a":10.4,"d":4.99,"text":"所以课程按依赖排成一条线，前课为后课铺路。","f":"bc4a5ae765.mp3","h":"bc4a5ae765","r":0},{"s":2,"a":0.6,"d":4.13,"text":"全程 6 个阶段：启程、入门、进阶，","f":"a5abf73be9.mp3","h":"a5abf73be9","r":0},{"s":2,"a":5.6,"d":4.54,"text":"再到原理、生产、专家，一步步走进生产。","f":"fba7f199bb.mp3","h":"fba7f199bb","r":0},{"s":2,"a":11,"d":4.61,"text":"阶段 0 到 3 本地就能跑，4、5 需要多台机器。","f":"f2c4d7be70.mp3","h":"f2c4d7be70","r":0},{"s":3,"a":0.6,"d":4.06,"text":"每课按为什么、是什么、怎么用来展开，","f":"84120dc21e.mp3","h":"84120dc21e","r":0},{"s":3,"a":5.6,"d":4.44,"text":"结尾固定有动手练习、自测和参考资料。","f":"5c2a447b54.mp3","h":"5c2a447b54","r":0},{"s":3,"a":10.8,"d":4.03,"text":"六种提示框，颜色和含义都是固定的。","f":"0aadf936c8.mp3","h":"0aadf936c8","r":0},{"s":4,"a":0.6,"d":4.46,"text":"每周 5 到 6 小时：阶段 0 到 1 约两周，","f":"88ea462afe.mp3","h":"88ea462afe","r":0},{"s":4,"a":5.6,"d":4.13,"text":"阶段 2 到 3 约四周，4 到 5 要四到八周。","f":"7748904b21.mp3","h":"7748904b21","r":0},{"s":4,"a":10.8,"d":3.72,"text":"宁可慢一点，也要把动手练习做一遍。","f":"ee8833dc95.mp3","h":"ee8833dc95","r":0},{"s":5,"a":0.6,"d":4.13,"text":"一台 8 GB 以上内存的电脑，推荐 16 GB。","f":"29f77fdfb7.mp3","h":"29f77fdfb7","r":0},{"s":5,"a":5.6,"d":4.42,"text":"装好 Docker 或 Podman，kind 靠它运行节点。","f":"d2a6f2e5e0.mp3","h":"d2a6f2e5e0","r":0},{"s":5,"a":10.8,"d":3.89,"text":"跑一下 hello-world，确认容器环境可用。","f":"7bf2c04c8b.mp3","h":"7bf2c04c8b","r":0},{"s":6,"a":0.8,"d":3.7,"text":"小结：按路线走，边学边动手。","f":"2ae3bd63d6.mp3","h":"2ae3bd63d6","r":0},{"s":6,"a":5.6,"d":3.22,"text":"下一课，把容器拆开看个明白。","f":"2e915cb401.mp3","h":"2e915cb401","r":0}]
