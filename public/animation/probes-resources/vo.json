[{"s":0,"a":3.2,"d":3.02,"text":"进程活着，不等于服务可用。","f":"1b24d6c7d0.mp3","h":"1b24d6c7d0","r":0},{"s":1,"a":0.6,"d":3.62,"text":"探针是 kubelet 对容器的定期诊断。","f":"f4e37f5623.mp3","h":"f4e37f5623","r":0},{"s":1,"a":5.2,"d":5.14,"text":"startupProbe 先确认启动完成，期间屏蔽另外两种。","f":"5e67c588ae.mp3","h":"5e67c588ae","r":0},{"s":1,"a":11,"d":4.03,"text":"之后 liveness 管重启，readiness 管流量。","f":"1e7b508325.mp3","h":"1e7b508325","r":0},{"s":2,"a":0.6,"d":4.25,"text":"就绪探针失败：摘除流量，但不重启。","f":"adcb1c2bcb.mp3","h":"adcb1c2bcb","r":0},{"s":2,"a":5.8,"d":4.3,"text":"存活探针失败：kubelet 直接重启容器。","f":"fc4418443c.mp3","h":"fc4418443c","r":0},{"s":2,"a":11,"d":4.44,"text":"别在 liveness 里查数据库，否则会全体重启。","f":"fa0ba9857d.mp3","h":"fa0ba9857d","r":0},{"s":3,"a":0.6,"d":4.75,"text":"requests 是调度依据，limits 是运行时上限。","f":"5276231d26.mp3","h":"5276231d26","r":0},{"s":3,"a":5.8,"d":4.92,"text":"CPU 超限只会被限流，进程变慢但不会死。","f":"1f4e173b04.mp3","h":"1f4e173b04","r":0},{"s":3,"a":11.2,"d":4.7,"text":"内存超限直接 OOMKilled，退出码 137。","f":"0fca42a0c0.mp3","h":"0fca42a0c0","r":0},{"s":4,"a":0.6,"d":4.94,"text":"K8s 按 requests 和 limits 自动划分 QoS。","f":"8a07a76d21.mp3","h":"8a07a76d21","r":11},{"s":4,"a":5.8,"d":4.66,"text":"全部相等是 Guaranteed，全不设是 BestEffort。","f":"74ae770539.mp3","h":"74ae770539","r":0},{"s":4,"a":10.8,"d":4.49,"text":"节点内存紧张时，BestEffort 最先被驱逐。","f":"bacea86b43.mp3","h":"bacea86b43","r":0},{"s":5,"a":0.6,"d":4.7,"text":"LimitRange 管单个容器：补默认值、卡上下限。","f":"6381dd91cb.mp3","h":"6381dd91cb","r":0},{"s":5,"a":6,"d":4.18,"text":"超出上限的容器，创建时就会被拒绝。","f":"8c05eeaf2c.mp3","h":"8c05eeaf2c","r":0},{"s":5,"a":10.6,"d":4.2,"text":"ResourceQuota 管总和，给命名空间划预算。","f":"18f03d6bbe.mp3","h":"18f03d6bbe","r":0},{"s":6,"a":0.8,"d":4.46,"text":"小结：探针管健康，资源声明管公平。","f":"7ae03ff80c.mp3","h":"7ae03ff80c","r":0},{"s":6,"a":5.6,"d":3.41,"text":"下一课，给应用接上持久存储。","f":"b0b5672b62.mp3","h":"b0b5672b62","r":0}]
