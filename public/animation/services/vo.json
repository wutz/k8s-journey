[{"s":0,"a":3.2,"d":3.58,"text":"Service：给一组 Pod 一个稳定入口。","f":"c222c61f28.mp3","h":"c222c61f28","r":0},{"s":1,"a":0.6,"d":4.42,"text":"Pod IP 会变，副本又多，客户端该连谁？","f":"7c05ab5ff9.mp3","h":"7c05ab5ff9","r":0},{"s":1,"a":5.6,"d":4.3,"text":"Service 给一组 Pod 稳定的虚拟 IP 和名字。","f":"87e0c71479.mp3","h":"87e0c71479","r":0},{"s":1,"a":10.8,"d":5.21,"text":"节点上的 kube-proxy 把 VIP 流量转给 Pod。","f":"4045fbb39c.mp3","h":"4045fbb39c","r":4},{"s":2,"a":0.6,"d":4.73,"text":"ClusterIP 是默认类型，只在集群内可达。","f":"66212d8976.mp3","h":"66212d8976","r":4},{"s":2,"a":5.6,"d":4.99,"text":"port 是 Service 端口，targetPort 指向容器。","f":"c19f840e4b.mp3","h":"c19f840e4b","r":8},{"s":2,"a":10.8,"d":3.77,"text":"连请求六次，流量分散到三个 Pod。","f":"49e38b5c1e.mp3","h":"49e38b5c1e","r":0},{"s":3,"a":0.6,"d":4.46,"text":"控制器把就绪 Pod 的地址写进 EndpointSlice。","f":"97dfe74a76.mp3","h":"97dfe74a76","r":0},{"s":3,"a":5.6,"d":3.98,"text":"缩容或未就绪，地址就从表里摘掉。","f":"95c86fe91b.mp3","h":"95c86fe91b","r":0},{"s":3,"a":10.8,"d":4.61,"text":"Service 不通？先看 Endpoints 是否为空。","f":"b1992daffc.mp3","h":"b1992daffc","r":0},{"s":4,"a":0.6,"d":4.49,"text":"CoreDNS 为每个 Service 生成 DNS 记录。","f":"6c465096a4.mp3","h":"6c465096a4","r":0},{"s":4,"a":5.6,"d":3.91,"text":"普通 Service，解析出一个 ClusterIP。","f":"71bfb512a1.mp3","h":"71bfb512a1","r":0},{"s":4,"a":10.8,"d":5.18,"text":"Headless 不分配 VIP，直接返回 Pod IP。","f":"266e929fab.mp3","h":"266e929fab","r":0},{"s":5,"a":0.6,"d":3.84,"text":"NodePort 在每个节点上开同一个端口。","f":"34cc648f4d.mp3","h":"34cc648f4d","r":0},{"s":5,"a":5.6,"d":4.44,"text":"LoadBalancer 再向云要一个外部 IP。","f":"58665e61b9.mp3","h":"58665e61b9","r":0},{"s":5,"a":10.8,"d":4.49,"text":"ExternalName 只是 DNS 里的一条 CNAME。","f":"6e285d81f3.mp3","h":"6e285d81f3","r":0},{"s":6,"a":0.8,"d":4.03,"text":"小结：Service 解决了 Pod 地址不固定。","f":"65d47e2046.mp3","h":"65d47e2046","r":0},{"s":6,"a":5.6,"d":4.2,"text":"下一课，用 ConfigMap 和 Secret 管配置。","f":"7967ee50c9.mp3","h":"7967ee50c9","r":0}]
