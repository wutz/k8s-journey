[{"s":0,"a":3.2,"d":3.91,"text":"Kubespray：一条命令部署高可用集群。","f":"1ea083bf66.mp3","h":"1ea083bf66","r":0},{"s":1,"a":0.6,"d":3.34,"text":"Kubespray 是一套 Ansible Playbook。","f":"74625af2b6.mp3","h":"74625af2b6","r":0},{"s":1,"a":5.6,"d":4.27,"text":"底层用 kubeadm，一条命令装好整个集群。","f":"3c7a545788.mp3","h":"3c7a545788","r":0},{"s":1,"a":10.8,"d":4.13,"text":"它是幂等的：改了配置，再跑一遍即可。","f":"3b7c796d85.mp3","h":"3b7c796d85","r":0},{"s":2,"a":0.6,"d":3.72,"text":"inventory.ini 按分组列出所有节点。","f":"766dd8bf8d.mp3","h":"766dd8bf8d","r":0},{"s":2,"a":5.6,"d":4.03,"text":"etcd 组指向控制平面，就是堆叠式 etcd。","f":"f1ab782026.mp3","h":"f1ab782026","r":0},{"s":2,"a":10.8,"d":4.13,"text":"主机名会直接成为 K8s 的 Node 名。","f":"945597e8cb.mp3","h":"945597e8cb","r":0},{"s":3,"a":0.6,"d":4.46,"text":"网络插件设成 cni，之后用 Helm 装 Cilium。","f":"a568f98ad9.mp3","h":"a568f98ad9","r":0},{"s":3,"a":6,"d":4.99,"text":"strict ARP 防止和 VIP 抢 ARP 应答。","f":"58ceef6f66.mp3","h":"58ceef6f66","r":0},{"s":3,"a":11.4,"d":4.58,"text":"etcd 配额调到 8 GiB，VIP 交给 kube-vip。","f":"e05b4fe774.mp3","h":"e05b4fe774","r":0},{"s":4,"a":0.6,"d":3.74,"text":"默认的 LeastAllocated 会把 Pod 打散。","f":"01b1e20874.mp3","h":"01b1e20874","r":0},{"s":4,"a":5.6,"d":4.39,"text":"6 个单卡任务一分散，8 卡任务就没地方了。","f":"cd64877c69.mp3","h":"cd64877c69","r":0},{"s":4,"a":10.6,"d":4.44,"text":"改成 MostAllocated 装箱，整机留给大任务。","f":"bd5b27beb7.mp3","h":"bd5b27beb7","r":0},{"s":5,"a":0.6,"d":4.01,"text":"改了配置用 --tags，只跑相关部分。","f":"d4457f901d.mp3","h":"d4457f901d","r":0},{"s":5,"a":5.4,"d":4.2,"text":"扩 worker 用 scale，扩控制平面用 recover。","f":"c4e3f9ae5b.mp3","h":"c4e3f9ae5b","r":0},{"s":5,"a":11,"d":4.32,"text":"reset 会清空 etcd，生产环境千万慎用。","f":"d294344284.mp3","h":"d294344284","r":0},{"s":6,"a":0.8,"d":4.34,"text":"小结：变量想清楚，部署只是一条命令。","f":"29cb4c5144.mp3","h":"29cb4c5144","r":0},{"s":6,"a":5.6,"d":4.13,"text":"下一课，装 Cilium、MetalLB 和证书。","f":"aee8116fd3.mp3","h":"aee8116fd3","r":0}]
