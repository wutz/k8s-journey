[{"s":0,"a":3.2,"d":3.62,"text":"告诉它你想要什么，它负责一直做到。","f":"d09d9d0be9.mp3","h":"d09d9d0be9","r":0},{"s":1,"a":0.6,"d":4.25,"text":"三台机器，靠 ssh 一台台 docker run。","f":"6d798ecdcd.mp3","h":"6d798ecdcd","r":0},{"s":1,"a":5.6,"d":3.82,"text":"半夜一台宕机，容器没了，也没人管。","f":"2bc749c066.mp3","h":"2bc749c066","r":0},{"s":1,"a":11,"d":4.7,"text":"放置、恢复、扩容、发布，全得自己扛。","f":"585527afe4.mp3","h":"585527afe4","r":0},{"s":2,"a":0.6,"d":3.84,"text":"命令式一步步下指令，执行完就结束。","f":"2882f0164b.mp3","h":"2882f0164b","r":0},{"s":2,"a":5.6,"d":3.48,"text":"声明式只写结果：我要 3 个副本。","f":"1a23de5e3e.mp3","h":"1a23de5e3e","r":0},{"s":2,"a":11,"d":4.2,"text":"重复提交也安全，能进 Git，还能自愈。","f":"3ebf13571d.mp3","h":"3ebf13571d","r":0},{"s":3,"a":0.6,"d":4.58,"text":"控制器不停循环：观察、比较、再行动。","f":"7276b9501b.mp3","h":"7276b9501b","r":0},{"s":3,"a":5.6,"d":4.22,"text":"删掉一个 Pod，实际 2 个，少于期望 3 个。","f":"fb676c825c.mp3","h":"fb676c825c","r":0},{"s":3,"a":11,"d":3.62,"text":"它马上补建一个，这个过程叫调谐。","f":"dfbbfe8382.mp3","h":"dfbbfe8382","r":0},{"s":4,"a":0.6,"d":4.46,"text":"控制平面负责决策，apiserver 是唯一入口；","f":"35c9dbdd80.mp3","h":"35c9dbdd80","r":0},{"s":4,"a":5.6,"d":4.44,"text":"etcd 存状态，调度器和控制器各司其职。","f":"aeacdf01b1.mp3","h":"aeacdf01b1","r":0},{"s":4,"a":11,"d":3.98,"text":"工作节点上，kubelet 调 containerd 跑 Pod。","f":"cffbe9ad80.mp3","h":"cffbe9ad80","r":0},{"s":5,"a":0.6,"d":3.96,"text":"apply 之后，apiserver 先把它写进 etcd。","f":"28e8d57300.mp3","h":"28e8d57300","r":0},{"s":5,"a":4.8,"d":4.42,"text":"控制器层层创建，调度器给 Pod 选节点，","f":"df0bfcf03a.mp3","h":"df0bfcf03a","r":0},{"s":5,"a":9.4,"d":3.24,"text":"kubelet 拉起容器，再上报状态。","f":"1d11b2578a.mp3","h":"1d11b2578a","r":4},{"s":5,"a":12.9,"d":3.29,"text":"所有组件只和 apiserver 通信。","f":"ddd4e66047.mp3","h":"ddd4e66047","r":0},{"s":6,"a":0.8,"d":3.86,"text":"小结：声明期望，交给控制循环。","f":"03b2e500b0.mp3","h":"03b2e500b0","r":0},{"s":6,"a":5.6,"d":3.48,"text":"下一课，在本机搭一个实验集群。","f":"bf99f07f86.mp3","h":"bf99f07f86","r":0}]
