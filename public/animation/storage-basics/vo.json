[{"s":0,"a":3.2,"d":3.7,"text":"容器的文件是临时的，数据要放哪？","f":"1ac0a4fbf6.mp3","h":"1ac0a4fbf6","r":0},{"s":1,"a":0.6,"d":3.36,"text":"emptyDir 与 Pod 同生共死。","f":"7abfeef0c4.mp3","h":"7abfeef0c4","r":0},{"s":1,"a":4.4,"d":3.89,"text":"容器重启数据还在，Pod 删除就没了。","f":"78845529f9.mp3","h":"78845529f9","r":0},{"s":1,"a":10.2,"d":4.08,"text":"持久卷独立于 Pod，重建后原样挂回。","f":"af419fd557.mp3","h":"af419fd557","r":0},{"s":2,"a":0.6,"d":4.22,"text":"开发者只写 PVC：要多大、怎么访问。","f":"8f32d798cd.mp3","h":"8f32d798cd","r":0},{"s":2,"a":5.4,"d":4.61,"text":"管理员建 StorageClass，按需自动造出 PV。","f":"8a809d4111.mp3","h":"8a809d4111","r":0},{"s":2,"a":10.8,"d":4.63,"text":"PV 与 PVC 一对一绑定，Pod 只认 PVC。","f":"0584689f8c.mp3","h":"0584689f8c","r":0},{"s":3,"a":0.6,"d":4.8,"text":"只建 PVC，它会停在 Pending，等第一个使用者。","f":"44ec42cf03.mp3","h":"44ec42cf03","r":0},{"s":3,"a":5.8,"d":4.18,"text":"Pod 调度到节点后，才在那里创建 PV。","f":"9bdedd2273.mp3","h":"9bdedd2273","r":0},{"s":3,"a":10.8,"d":4.13,"text":"若用 Immediate，卷和 Pod 可能各在一边。","f":"3f35ea503b.mp3","h":"3f35ea503b","r":0},{"s":4,"a":0.6,"d":5.06,"text":"RWO 限制的是节点，同节点多个 Pod 都能挂。","f":"e0114ee63f.mp3","h":"e0114ee63f","r":0},{"s":4,"a":5.8,"d":4.51,"text":"ROX 多节点只读，RWX 多节点读写。","f":"ec641c5d18.mp3","h":"ec641c5d18","r":0},{"s":4,"a":10.8,"d":4.68,"text":"严格单写者用 RWOP，只允许一个 Pod。","f":"6d9962dd2e.mp3","h":"6d9962dd2e","r":0},{"s":5,"a":0.6,"d":4.56,"text":"删除 PVC 后，PV 如何处理由回收策略决定。","f":"b0e502d985.mp3","h":"b0e502d985","r":9},{"s":5,"a":5.4,"d":4.44,"text":"Delete 连数据一起删，Retain 留下 Released。","f":"f52d3f6f98.mp3","h":"f52d3f6f98","r":0},{"s":5,"a":10.8,"d":4.49,"text":"管理员确认后删掉 claimRef，PV 才能复用。","f":"7e09baa144.mp3","h":"7e09baa144","r":0},{"s":6,"a":0.8,"d":3.91,"text":"小结：PVC 把应用和存储解耦。","f":"a04bc9fbdc.mp3","h":"a04bc9fbdc","r":0},{"s":6,"a":5.6,"d":4.27,"text":"下一课，用 StatefulSet 部署有状态应用。","f":"d3ad3372ef.mp3","h":"d3ad3372ef","r":0}]
