[{"s":0,"a":3.2,"d":3.74,"text":"调度：决定每个 Pod 落在哪个节点。","f":"6afdbd61e4.mp3","h":"6afdbd61e4","r":0},{"s":1,"a":0.6,"d":4.06,"text":"调度器分三步：过滤、打分、绑定。","f":"bed4f49eb7.mp3","h":"bed4f49eb7","r":0},{"s":1,"a":5.6,"d":4.68,"text":"硬约束在过滤阶段生效，全不满足就 Pending。","f":"69ad49f2b8.mp3","h":"69ad49f2b8","r":0},{"s":1,"a":11,"d":3.86,"text":"软偏好只加分，分最高的节点胜出。","f":"0c296419f2.mp3","h":"0c296419f2","r":0},{"s":2,"a":0.6,"d":4.34,"text":"污点让节点拒绝 Pod，除非 Pod 带着容忍。","f":"014e0530e9.mp3","h":"014e0530e9","r":0},{"s":2,"a":5.6,"d":5.06,"text":"NoExecute 更狠：已在运行的 Pod 也会被驱逐。","f":"f378562922.mp3","h":"f378562922","r":0},{"s":2,"a":10.8,"d":4.49,"text":"容忍不等于吸引，专用节点还要配亲和性。","f":"1413630e20.mp3","h":"1413630e20","r":0},{"s":3,"a":0.6,"d":4.7,"text":"硬反亲和：一个节点一个副本，多余的 Pending。","f":"7f6aa73220.mp3","h":"7f6aa73220","r":0},{"s":3,"a":5.6,"d":4.66,"text":"拓扑分布更灵活：只限制各区副本数之差。","f":"16898e7541.mp3","h":"16898e7541","r":0},{"s":3,"a":10.8,"d":5.14,"text":"maxSkew 为 1：3/3、4/3 可以，5/3 不行。","f":"e044476224.mp3","h":"e044476224","r":0},{"s":4,"a":0.6,"d":4.08,"text":"PriorityClass 给 Pod 一个整数优先级。","f":"99471c2f00.mp3","h":"99471c2f00","r":0},{"s":4,"a":5.6,"d":4.85,"text":"资源不足时，高优先级 Pod 会抢占低优先级的。","f":"57f526ea1a.mp3","h":"57f526ea1a","r":0},{"s":4,"a":10.8,"d":5.18,"text":"至少分三档：平台组件、在线服务、离线批处理。","f":"740a342b3f.mp3","h":"740a342b3f","r":4},{"s":5,"a":0.6,"d":4.54,"text":"维护节点前，先 cordon 标记为不可调度。","f":"528a838845.mp3","h":"528a838845","r":0},{"s":5,"a":5.6,"d":3.96,"text":"drain 逐个驱逐 Pod，让它们去别处重建。","f":"fbe0880fdd.mp3","h":"fbe0880fdd","r":0},{"s":5,"a":10.6,"d":4.54,"text":"驱逐遵守 PDB，可用副本不会低于下限。","f":"8ba35eec0c.mp3","h":"8ba35eec0c","r":0},{"s":6,"a":0.8,"d":3.86,"text":"小结：硬约束过滤，软偏好打分。","f":"6eb6405dcd.mp3","h":"6eb6405dcd","r":0},{"s":6,"a":5.4,"d":3.98,"text":"下一课，用 Helm 和 Kustomize 管理应用。","f":"752f5dc260.mp3","h":"752f5dc260","r":0}]
