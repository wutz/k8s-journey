[{"s":0,"a":3.2,"d":3.6,"text":"攻击者从应用进来之后，还能做什么？","f":"5fd5b120c7.mp3","h":"5fd5b120c7","r":0},{"s":1,"a":0.6,"d":4.1,"text":"容器里的 root，就是宿主机的 UID 0。","f":"09e96c9cd2.mp3","h":"09e96c9cd2","r":0},{"s":1,"a":5.4,"d":4.9,"text":"securityContext 让它以非 root 运行、禁止提权。","f":"a9fa90dc9d.mp3","h":"a9fa90dc9d","r":0},{"s":1,"a":10.6,"d":4.13,"text":"根文件系统只读，Linux 能力全部去掉。","f":"b9ec1b0832.mp3","h":"b9ec1b0832","r":0},{"s":2,"a":0.6,"d":4.32,"text":"Pod 安全标准分三级，一级比一级严格。","f":"aaaac93702.mp3","h":"aaaac93702","r":0},{"s":2,"a":5.4,"d":4.99,"text":"给命名空间打上 enforce 标签，由 PSA 执行。","f":"42894ed010.mp3","h":"42894ed010","r":15},{"s":2,"a":10.6,"d":4.25,"text":"普通 nginx 被拒之门外，加固过的顺利通过。","f":"8b6ad5db9d.mp3","h":"8b6ad5db9d","r":0},{"s":3,"a":0.6,"d":4.27,"text":"默认情况下，任何 Pod 都能访问任何 Pod。","f":"00eb090baa.mp3","h":"00eb090baa","r":0},{"s":3,"a":5.4,"d":3.89,"text":"先放一条默认拒绝，所有流量被切断。","f":"fce9c363f3.mp3","h":"fce9c363f3","r":0},{"s":3,"a":10.6,"d":4.82,"text":"再逐条放行：DNS，以及 frontend 到 api。","f":"a8a1187827.mp3","h":"a8a1187827","r":0},{"s":4,"a":0.6,"d":4.56,"text":"标准策略只能按 IP 段限制出口，可 IP 常变。","f":"0a20691779.mp3","h":"0a20691779","r":8},{"s":4,"a":5.4,"d":5.18,"text":"Cilium 的 toFQDNs 按域名放行，先代理 DNS 查询，","f":"4a65e39861.mp3","h":"4a65e39861","r":11},{"s":4,"a":10.8,"d":4.2,"text":"学到解析出的 IP，再动态加入白名单。","f":"9cb875e42c.mp3","h":"9cb875e42c","r":0},{"s":5,"a":0.6,"d":4.61,"text":"想要自定义规则？比如镜像只能来自内部仓库。","f":"d2e09fe959.mp3","h":"d2e09fe959","r":16},{"s":5,"a":5.4,"d":4.15,"text":"ValidatingAdmissionPolicy 用 CEL 直接校验。","f":"5043dc158c.mp3","h":"5043dc158c","r":0},{"s":5,"a":10.4,"d":4.34,"text":"Policy 定规则，Binding 定范围和处理方式。","f":"558492ebc0.mp3","h":"558492ebc0","r":0},{"s":6,"a":0.8,"d":4.51,"text":"小结：从容器权限到网络出口，逐层加固。","f":"ed15c0b5a0.mp3","h":"ed15c0b5a0","r":4},{"s":6,"a":5.6,"d":3.62,"text":"下一课，让应用随流量自动扩缩。","f":"bde54ee9a3.mp3","h":"bde54ee9a3","r":0}]
