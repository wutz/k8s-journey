[{"s":0,"a":3.2,"d":3.98,"text":"把大模型变成稳定、高效的推理服务。","f":"7082367cf8.mp3","h":"7082367cf8","r":0},{"s":1,"a":0.6,"d":4.1,"text":"LLM 推理分两段：Prefill 和 Decode。","f":"7900e22411.mp3","h":"7900e22411","r":0},{"s":1,"a":5,"d":4.42,"text":"Prefill 一次算完整段输入，决定首字延迟。","f":"9ccd8cb6e9.mp3","h":"9ccd8cb6e9","r":0},{"s":1,"a":10.6,"d":4.66,"text":"Decode 逐个生成 token，间隔就是 TPOT。","f":"c029b2314c.mp3","h":"c029b2314c","r":0},{"s":2,"a":0.6,"d":4.25,"text":"单机部署：一个 StatefulSet 跑 vLLM。","f":"a052e8c720.mp3","h":"a052e8c720","r":0},{"s":2,"a":5.2,"d":4.32,"text":"显存除了权重，剩下的都分给 KV Cache。","f":"8a2e8a3e09.mp3","h":"8a2e8a3e09","r":0},{"s":2,"a":10.4,"d":4.37,"text":"加载权重要几分钟，一定要配 startupProbe。","f":"1eb7d760f1.mp3","h":"1eb7d760f1","r":0},{"s":3,"a":0.6,"d":4.01,"text":"671B 的大模型，单机 8 卡放不下。","f":"f46615d833.mp3","h":"f46615d833","r":18},{"s":3,"a":4.8,"d":3.6,"text":"LWS 把一组 Pod 当成一个副本。","f":"aaa1bed97e.mp3","h":"aaa1bed97e","r":12},{"s":3,"a":8.6,"d":2.38,"text":"Service 只选中 leader。","f":"f04920302d.mp3","h":"f04920302d","r":0},{"s":3,"a":12.2,"d":4.15,"text":"任一 Pod 重启，整组重建、重新加载。","f":"7a69029647.mp3","h":"7a69029647","r":0},{"s":4,"a":0.6,"d":4.87,"text":"普通负载均衡只会轮询，打散了 KV 缓存。","f":"0d99d3a2ab.mp3","h":"0d99d3a2ab","r":0},{"s":4,"a":5.6,"d":4.78,"text":"推理网关每收到请求，都先问 EPP 发给谁。","f":"9c4a2e7e8b.mp3","h":"9c4a2e7e8b","r":0},{"s":4,"a":10.8,"d":4.66,"text":"EPP 按前缀命中、队列和 KV 使用率打分。","f":"7935ab5ad2.mp3","h":"7935ab5ad2","r":0},{"s":5,"a":0.6,"d":3.91,"text":"长输入的 Prefill 会卡住同批 Decode。","f":"7cfca2cdcf.mp3","h":"7cfca2cdcf","r":0},{"s":5,"a":5.4,"d":5.09,"text":"PD 分离把两段拆开，KV 经 RDMA 传过去。","f":"95ff8008e3.mp3","h":"95ff8008e3","r":0},{"s":5,"a":10.8,"d":4.85,"text":"llm-d 把引擎、网关和部署形态组合起来。","f":"6265470d25.mp3","h":"6265470d25","r":0},{"s":6,"a":0.8,"d":4.56,"text":"小结：大模型推理，要围绕 KV Cache 来调度。","f":"a7d77905e3.mp3","h":"a7d77905e3","r":5},{"s":6,"a":5.6,"d":3.17,"text":"下一课，多租户与平台工程。","f":"6f408f44ed.mp3","h":"6f408f44ed","r":0}]
