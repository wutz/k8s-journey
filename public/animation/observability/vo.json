[{"s":0,"a":3.2,"d":4.56,"text":"集群好不好，要靠指标、日志和事件来回答。","f":"f4c78e3dc2.mp3","h":"f4c78e3dc2","r":0},{"s":1,"a":0.5,"d":2.57,"text":"可观测性有四类信号。","f":"5a8426dca1.mp3","h":"5a8426dca1","r":0},{"s":1,"a":3.6,"d":6.34,"text":"指标看趋势，日志看细节，事件看集群动作，链路看慢在哪。","f":"2a7355dd24.mp3","h":"2a7355dd24","r":0},{"s":1,"a":10.2,"d":5.83,"text":"排查顺序：告警、面板、事件、日志，最后是链路。","f":"fe2255cb3c.mp3","h":"fe2255cb3c","r":0},{"s":2,"a":0.6,"d":4.42,"text":"指标栈选用 VictoriaMetrics，兼容 Prometheus。","f":"512d1a2dfe.mp3","h":"512d1a2dfe","r":0},{"s":2,"a":5.4,"d":3.82,"text":"vmagent 抓取指标，写进 vmsingle 存储。","f":"4b147fb5c9.mp3","h":"4b147fb5c9","r":12},{"s":2,"a":9.4,"d":3.41,"text":"Grafana 看图，vmalert 计算告警。","f":"baf8b28b8b.mp3","h":"baf8b28b8b","r":17},{"s":2,"a":13,"d":3.79,"text":"现成的 ServiceMonitor 会被自动转换。","f":"64e667479a.mp3","h":"64e667479a","r":0},{"s":3,"a":0.6,"d":3.34,"text":"告警规则用 PrometheusRule 声明。","f":"e8462df09b.mp3","h":"e8462df09b","r":0},{"s":3,"a":4.4,"d":2.95,"text":"盯住 etcd 用量与配额之比。","f":"e5feca6f86.mp3","h":"e5feca6f86","r":0},{"s":3,"a":8.6,"d":4.18,"text":"过了阈值先 pending，持续满 for 才 firing。","f":"0af3df08ca.mp3","h":"0af3df08ca","r":14},{"s":3,"a":13,"d":3.14,"text":"Alertmanager 按级别分发通知。","f":"dac91161e4.mp3","h":"dac91161e4","r":4},{"s":4,"a":0.6,"d":4.13,"text":"容器日志写在节点的 /var/log/pods 下。","f":"806a791441.mp3","h":"806a791441","r":0},{"s":4,"a":5,"d":4.3,"text":"采集器 DaemonSet 读文件，发往日志后端。","f":"a27b979dc9.mp3","h":"a27b979dc9","r":0},{"s":4,"a":9.6,"d":3.6,"text":"带污点的节点要加容忍，否则整片缺日志。","f":"dc1ad8bae3.mp3","h":"dc1ad8bae3","r":21},{"s":4,"a":13.4,"d":3.22,"text":"VictoriaLogs 查询更灵活，运维更轻。","f":"70fcce4393.mp3","h":"70fcce4393","r":22},{"s":5,"a":0.6,"d":4.2,"text":"Event 存在 etcd 里，默认只保留 1 小时。","f":"d649a93f77.mp3","h":"d649a93f77","r":0},{"s":5,"a":5.8,"d":3.98,"text":"凌晨三点的 OOM，早上九点就查不到了。","f":"104c7617d5.mp3","h":"104c7617d5","r":0},{"s":5,"a":10.4,"d":4.97,"text":"event-exporter 把事件写进日志系统长期保存。","f":"762864a52c.mp3","h":"762864a52c","r":0},{"s":6,"a":0.8,"d":4.56,"text":"小结：指标发现问题，事件和日志定位原因。","f":"0ff5b5bdf5.mp3","h":"0ff5b5bdf5","r":7},{"s":6,"a":5.6,"d":4.08,"text":"下一课，搭建镜像仓库与镜像分发。","f":"57f0469cac.mp3","h":"57f0469cac","r":0}]
