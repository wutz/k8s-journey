[{"s":0,"a":3.2,"d":4.9,"text":"你是谁？你能做什么？apiserver 的两道关。","f":"3ddfd2299c.mp3","h":"3ddfd2299c","r":9},{"s":1,"a":0.6,"d":4.2,"text":"K8s 里没有 User 对象，身份来自凭据。","f":"1a61e49326.mp3","h":"1a61e49326","r":6},{"s":1,"a":5,"d":4.63,"text":"证书 CN、Token 的 sub，映射成用户名和组。","f":"701d9a30f8.mp3","h":"701d9a30f8","r":0},{"s":1,"a":10.6,"d":4.87,"text":"全部认证失败，返回 401 或当作匿名用户。","f":"10cfabf1ae.mp3","h":"10cfabf1ae","r":0},{"s":2,"a":0.6,"d":3.84,"text":"Pod 启动时，kubelet 挂载一个投射卷。","f":"125cf5a0a0.mp3","h":"125cf5a0a0","r":0},{"s":2,"a":4.8,"d":4.49,"text":"Token 约一小时过期，绑定 Pod，还带受众。","f":"854a9094c3.mp3","h":"854a9094c3","r":0},{"s":2,"a":10.2,"d":4.75,"text":"旧的 Secret Token 永不过期；不需要就关掉挂载。","f":"6814a91acd.mp3","h":"6814a91acd","r":0},{"s":3,"a":0.6,"d":4.78,"text":"RBAC 只有四种对象：两种角色，两种绑定。","f":"735be554e6.mp3","h":"735be554e6","r":6},{"s":3,"a":5.6,"d":4.97,"text":"Role 写规则：哪些 API 组、资源、动词。","f":"33080f3878.mp3","h":"33080f3878","r":0},{"s":3,"a":11.2,"d":4.7,"text":"规则只有允许，权限取并集，其余一律拒绝。","f":"830f82ddfd.mp3","h":"830f82ddfd","r":0},{"s":4,"a":0.6,"d":3.17,"text":"ClusterRole 能被两种绑定引用。","f":"0eac6399cb.mp3","h":"0eac6399cb","r":0},{"s":4,"a":4.4,"d":3.77,"text":"RoleBinding 绑：只在所在命名空间生效。","f":"d68dabc52f.mp3","h":"d68dabc52f","r":4},{"s":4,"a":8.4,"d":3.5,"text":"ClusterRoleBinding 绑：全集群生效。","f":"39912f51eb.mp3","h":"39912f51eb","r":0},{"s":4,"a":12.2,"d":3.79,"text":"优先复用内置的 view、edit、admin。","f":"231a8387ae.mp3","h":"231a8387ae","r":0},{"s":5,"a":0.6,"d":3.6,"text":"写完权限，用 can-i 模拟身份来验证。","f":"b96c6c6ab5.mp3","h":"b96c6c6ab5","r":13},{"s":5,"a":4.4,"d":4.3,"text":"dev-wang 只能改 team-a，能看命名空间列表。","f":"ff5d53e39e.mp3","h":"ff5d53e39e","r":0},{"s":5,"a":10,"d":4.85,"text":"越权访问 kube-system，直接 403 Forbidden。","f":"2e90f337f8.mp3","h":"2e90f337f8","r":0},{"s":6,"a":0.8,"d":4.58,"text":"小结：认证认出你，RBAC 决定你能做什么。","f":"4c74247f12.mp3","h":"4c74247f12","r":6},{"s":6,"a":5.6,"d":3.24,"text":"下一课，工作负载安全加固。","f":"5785c60127.mp3","h":"5785c60127","r":0}]
