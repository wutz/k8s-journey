[{"s":0,"a":3.2,"d":3.72,"text":"Pod：Kubernetes 最小的调度单元。","f":"4aef7bd284.mp3","h":"4aef7bd284","r":0},{"s":1,"a":0.6,"d":4.25,"text":"K8s 不直接调度容器，而是调度 Pod。","f":"0f04532494.mp3","h":"0f04532494","r":0},{"s":1,"a":5.4,"d":5.35,"text":"同一 Pod 里的容器共享网络与存储，用 localhost 互访。","f":"86d1370009.mp3","h":"86d1370009","r":0},{"s":1,"a":11,"d":3.98,"text":"它们总被放到同一个节点上，同生共死。","f":"348cd30a37.mp3","h":"348cd30a37","r":0},{"s":2,"a":0.6,"d":4.42,"text":"Pod 从 Pending 开始：等待调度、拉取镜像。","f":"9934b57abe.mp3","h":"9934b57abe","r":0},{"s":2,"a":5.6,"d":4.37,"text":"容器跑起来就进入 Running，READY 变成 1/1。","f":"3d41875784.mp3","h":"3d41875784","r":0},{"s":2,"a":10.6,"d":5.18,"text":"全部成功退出是 Succeeded，有容器失败就是 Failed。","f":"19ffd551c7.mp3","h":"19ffd551c7","r":0},{"s":3,"a":0.6,"d":3.86,"text":"restartPolicy 决定容器退出以后怎么办。","f":"204237e852.mp3","h":"204237e852","r":0},{"s":3,"a":5.4,"d":5.28,"text":"Always 总是重启，OnFailure 失败才重启，Never 不重启。","f":"82aa7b1a7d.mp3","h":"82aa7b1a7d","r":0},{"s":3,"a":11.4,"d":6,"text":"反复崩溃时重启间隔成倍拉长，这就是 CrashLoopBackOff。","f":"597ab693eb.mp3","h":"597ab693eb","r":0},{"s":4,"a":0.6,"d":3.62,"text":"排查问题的三件套：logs 看日志，","f":"955a49cf42.mp3","h":"955a49cf42","r":0},{"s":4,"a":5,"d":4.8,"text":"exec 进到容器里，port-forward 把端口转到本机。","f":"041da12c9c.mp3","h":"041da12c9c","r":0},{"s":4,"a":10.6,"d":4.39,"text":"容器崩了，用 --previous 看上一次的日志。","f":"8bd449f120.mp3","h":"8bd449f120","r":0},{"s":5,"a":0.6,"d":4.37,"text":"Init 容器按顺序跑完，主容器才会启动。","f":"b11d863348.mp3","h":"b11d863348","r":0},{"s":5,"a":6,"d":5.14,"text":"1.29 起的原生 Sidecar 先启动，陪主容器一直运行。","f":"0408110c33.mp3","h":"0408110c33","r":5},{"s":5,"a":11.4,"d":4.66,"text":"日志收集、代理这类辅助进程，就放进 Sidecar。","f":"87ea92d566.mp3","h":"87ea92d566","r":5},{"s":6,"a":0.8,"d":3.86,"text":"小结：Pod 是所有工作负载的基石。","f":"c3b963f1b0.mp3","h":"c3b963f1b0","r":0},{"s":6,"a":5.6,"d":4.27,"text":"下一课，用标签和命名空间组织资源。","f":"3737121a72.mp3","h":"3737121a72","r":0}]
