[{"s":0,"a":3.2,"d":4.06,"text":"Helm 与 Kustomize：管理应用的两种思路。","f":"e68ac71157.mp3","h":"e68ac71157","r":0},{"s":1,"a":0.6,"d":4.73,"text":"Helm 用模板加参数，渲染出最终 YAML。","f":"195d9fffc2.mp3","h":"195d9fffc2","r":0},{"s":1,"a":5.6,"d":4.73,"text":"Kustomize 不写模板，给普通 YAML 打补丁。","f":"223afaf4ca.mp3","h":"223afaf4ca","r":0},{"s":1,"a":10.8,"d":4.97,"text":"别人的软件用 Helm 装，自己的配置用 Kustomize 管。","f":"1ca2ed1e0d.mp3","h":"1ca2ed1e0d","r":0},{"s":2,"a":0.6,"d":4.49,"text":"Chart 是安装包，装进集群就是一个 Release。","f":"40214a4723.mp3","h":"40214a4723","r":0},{"s":2,"a":5.6,"d":4.75,"text":"每次升级产生一个新修订，记录在 Secret 里。","f":"e0b6dfa559.mp3","h":"e0b6dfa559","r":0},{"s":2,"a":10.6,"d":3.77,"text":"回滚到修订 1，会生成新的修订 3。","f":"8b0dd686fc.mp3","h":"8b0dd686fc","r":0},{"s":3,"a":0.6,"d":4.97,"text":"合并顺序：默认值、-f 文件，最后是 --set。","f":"d5eba588e3.mp3","h":"d5eba588e3","r":8},{"s":3,"a":5.8,"d":4.34,"text":"后面的覆盖前面的，--set 优先级最高。","f":"9bb437553b.mp3","h":"9bb437553b","r":0},{"s":3,"a":10.6,"d":4.68,"text":"upgrade 不保留上次的 --set，值会被还原。","f":"19b8f10382.mp3","h":"19b8f10382","r":0},{"s":4,"a":0.6,"d":4.78,"text":"base 放各环境共用的 YAML，overlay 只写差异。","f":"714298261a.mp3","h":"714298261a","r":9},{"s":4,"a":5.6,"d":4.49,"text":"prod 改镜像标签和副本数，再打资源补丁。","f":"12bf944787.mp3","h":"12bf944787","r":0},{"s":4,"a":10.6,"d":5.02,"text":"配置一变，名字里的哈希就变，Pod 自动滚动更新。","f":"29749013e0.mp3","h":"29749013e0","r":0},{"s":5,"a":0.6,"d":3.53,"text":"Helmwave 把 Release 写成声明文件。","f":"4722e8fabb.mp3","h":"4722e8fabb","r":0},{"s":5,"a":5.2,"d":5.3,"text":"先装 CRD，depends_on 保证控制器后装。","f":"0b9143d30e.mp3","h":"0b9143d30e","r":0},{"s":5,"a":10.8,"d":4.9,"text":"Helm 装软件，Kustomize 补资源，Helmwave 定顺序。","f":"4cf6055a54.mp3","h":"4cf6055a54","r":0},{"s":6,"a":0.8,"d":4.37,"text":"小结：装软件用 Helm，管配置用 Kustomize。","f":"d477569ff4.mp3","h":"d477569ff4","r":7},{"s":6,"a":5.4,"d":2.93,"text":"下一课，看一个 Pod 的诞生。","f":"f3d663363a.mp3","h":"f3d663363a","r":0}]
