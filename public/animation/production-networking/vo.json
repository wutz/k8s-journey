[{"s":0,"a":3.2,"d":4.61,"text":"生产网络：Pod 网络、入口 IP 和证书。","f":"d19484ad72.mp3","h":"d19484ad72","r":0},{"s":1,"a":0.6,"d":3.77,"text":"Cilium 一装好，节点就变成 Ready。","f":"8fc6a11c3d.mp3","h":"8fc6a11c3d","r":0},{"s":1,"a":5.4,"d":4.27,"text":"apiserver 地址指向本机代理，避免单点。","f":"089b6b8bc7.mp3","h":"089b6b8bc7","r":0},{"s":1,"a":10.8,"d":3.98,"text":"Pod 网段用完了，只能在列表末尾追加。","f":"b8b21b1714.mp3","h":"b8b21b1714","r":0},{"s":2,"a":0.6,"d":4.22,"text":"裸金属上，LoadBalancer 的 IP 会一直 pending。","f":"b8c2f4b320.mp3","h":"b8c2f4b320","r":0},{"s":2,"a":5.6,"d":5.11,"text":"MetalLB 从地址池分配 IP，由一个节点回应 ARP。","f":"b1cb512617.mp3","h":"b1cb512617","r":0},{"s":2,"a":11,"d":4.51,"text":"这台挂了别的节点接管，L2 只有故障切换。","f":"100873a4ca.mp3","h":"100873a4ca","r":0},{"s":3,"a":0.6,"d":3.41,"text":"Service 拿到了 IP，却 ping 不通？","f":"ac4de6c5c5.mp3","h":"ac4de6c5c5","r":0},{"s":3,"a":4.6,"d":5.02,"text":"kubeadm 给控制平面打了排除 LB 的标签。","f":"c6fb5b9b40.mp3","h":"c6fb5b9b40","r":0},{"s":3,"a":10.4,"d":4.9,"text":"给 speaker 加上 ignoreExcludeLB，ARP 就有回应了。","f":"f87839c548.mp3","h":"f87839c548","r":0},{"s":4,"a":0.6,"d":4.99,"text":"声明 Certificate，cert-manager 签好证书存进 Secret。","f":"37b7e7d197.mp3","h":"37b7e7d197","r":11},{"s":4,"a":5.8,"d":5.14,"text":"HTTP-01 要公网可达，通配证书得用 DNS-01。","f":"7570130536.mp3","h":"7570130536","r":13},{"s":4,"a":11.2,"d":4.82,"text":"先用 staging 调通，webhook 要 2 副本加 PDB。","f":"0789a9d164.mp3","h":"0789a9d164","r":4},{"s":5,"a":0.6,"d":4.73,"text":"ingress-nginx 已归档，新集群改用 Gateway API。","f":"692bbf54c8.mp3","h":"692bbf54c8","r":0},{"s":5,"a":5.8,"d":5.04,"text":"Gateway 归基础设施，挂泛域名证书和固定 IP。","f":"e11a6e5b3b.mp3","h":"e11a6e5b3b","r":0},{"s":5,"a":11.2,"d":4.68,"text":"打了标签的命名空间，才能挂上 HTTPRoute。","f":"ccfbf05a54.mp3","h":"ccfbf05a54","r":0},{"s":6,"a":0.8,"d":4.58,"text":"小结：网络、入口、证书，一条链路打通。","f":"c01cbe7210.mp3","h":"c01cbe7210","r":6},{"s":6,"a":5.6,"d":4.3,"text":"下一课，生产存储：CSI 与 Rook-Ceph。","f":"61ff550ccc.mp3","h":"61ff550ccc","r":0}]
