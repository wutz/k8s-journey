[{"s":0,"a":3.2,"d":4.68,"text":"学完只是起点：考认证，跟版本，进社区。","f":"1444b6822f.mp3","h":"1444b6822f","r":0},{"s":1,"a":0.6,"d":5.06,"text":"CNCF 三门认证，都是真实终端里的实操考试。","f":"c513afa2f8.mp3","h":"c513afa2f8","r":0},{"s":1,"a":5.8,"d":4.97,"text":"CKA 管集群，CKAD 管应用，CKS 管安全。","f":"345dcf24d4.mp3","h":"345dcf24d4","r":13},{"s":1,"a":11,"d":4.42,"text":"注意：考 CKS 要先持有有效的 CKA。","f":"6077738098.mp3","h":"6077738098","r":0},{"s":2,"a":0.6,"d":3.12,"text":"实操考试最大的敌人是时间。","f":"4ac7f8b5a4.mp3","h":"4ac7f8b5a4","r":0},{"s":2,"a":4.6,"d":4.61,"text":"设好别名，用 dry-run 生成 YAML 骨架。","f":"cedc7ef673.mp3","h":"cedc7ef673","r":0},{"s":2,"a":10.4,"d":4.37,"text":"每道题先切换上下文，改错集群最丢分。","f":"944d9d2103.mp3","h":"944d9d2103","r":0},{"s":3,"a":0.6,"d":3.77,"text":"K8s 约每 4 个月发一个小版本。","f":"3ce9318c3a.mp3","h":"3ce9318c3a","r":0},{"s":3,"a":5.2,"d":3.74,"text":"每个版本只有约 14 个月的补丁支持。","f":"300f807dbb.mp3","h":"300f807dbb","r":0},{"s":3,"a":10.4,"d":3.46,"text":"一年不升级，就可能掉出支持期。","f":"7e8c7b6338.mp3","h":"7e8c7b6338","r":0},{"s":4,"a":0.6,"d":3.65,"text":"每个重要功能，都始于一份 KEP。","f":"2bd36e8f98.mp3","h":"2bd36e8f98","r":0},{"s":4,"a":4.8,"d":4.78,"text":"经过 alpha、beta 到 GA，每阶段至少一个版本。","f":"dff5444858.mp3","h":"dff5444858","r":0},{"s":4,"a":10.4,"d":4.58,"text":"升级前，先扫描仍在调用的废弃 API。","f":"69cfd5622d.mp3","h":"69cfd5622d","r":0},{"s":5,"a":0.6,"d":4.22,"text":"K8s 由一个个 SIG 按领域维护。","f":"8a91dc5dbb.mp3","h":"8a91dc5dbb","r":0},{"s":5,"a":5.2,"d":4.44,"text":"参与由浅入深：从旁听例会到贡献代码。","f":"978578541d.mp3","h":"978578541d","r":0},{"s":5,"a":10.6,"d":3.65,"text":"把你踩过的坑写出来，也是一种贡献。","f":"f968240856.mp3","h":"f968240856","r":0},{"s":6,"a":0.8,"d":4.56,"text":"小结：学完只是起点，持续学习才是关键。","f":"da37114d55.mp3","h":"da37114d55","r":6},{"s":6,"a":5.6,"d":4.01,"text":"恭喜走完全程，祝你的集群一直健康。","f":"deadb87751.mp3","h":"deadb87751","r":0}]
