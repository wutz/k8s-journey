[{"s":0,"a":3.2,"d":4.9,"text":"镜像从哪来、怎么拉得快，是生产集群的基础设施。","f":"b706ea7b42.mp3","h":"b706ea7b42","r":4},{"s":1,"a":0.6,"d":4.08,"text":"kubelet 经 CRI 让 containerd 拉镜像。","f":"60e1092fdd.mp3","h":"60e1092fdd","r":0},{"s":1,"a":4.8,"d":4.01,"text":"按主机名找到 hosts.toml，依次尝试镜像源。","f":"43454d8b00.mp3","h":"43454d8b00","r":13},{"s":1,"a":9,"d":3.02,"text":"Spegel 没有，就去内网镜像站。","f":"12bb4a4b3c.mp3","h":"12bb4a4b3c","r":0},{"s":1,"a":12.4,"d":4.42,"text":"拿到 manifest 和各层，解压后启动容器。","f":"4c9592e71b.mp3","h":"4c9592e71b","r":0},{"s":2,"a":0.6,"d":3.84,"text":"私有仓库二选一：Registry 或 Harbor。","f":"d5da1591e6.mp3","h":"d5da1591e6","r":0},{"s":2,"a":4.6,"d":3.82,"text":"Registry 就一个服务加一块存储，很轻。","f":"1377390748.mp3","h":"1377390748","r":6},{"s":2,"a":8.6,"d":3.62,"text":"Harbor 带 RBAC、代理缓存和漏洞扫描。","f":"cc290ce754.mp3","h":"cc290ce754","r":15},{"s":2,"a":12.4,"d":3.72,"text":"缺省用 Registry，有需求再上 Harbor。","f":"303ae2ab6d.mp3","h":"303ae2ab6d","r":8},{"s":3,"a":0.6,"d":4.13,"text":"按主机名分目录，每个目录一份 hosts.toml。","f":"dfb5498eec.mp3","h":"dfb5498eec","r":4},{"s":3,"a":5,"d":3.86,"text":"server 是回源地址，host 是镜像源。","f":"df7e1e4216.mp3","h":"df7e1e4216","r":0},{"s":3,"a":9.2,"d":3.41,"text":"hosts.toml 改完无需重启即生效。","f":"2305b1a572.mp3","h":"2305b1a572","r":4},{"s":3,"a":12.8,"d":3.31,"text":"Kubespray 用一个变量下发到所有节点。","f":"04be43ca35.mp3","h":"04be43ca35","r":18},{"s":4,"a":0.6,"d":3.94,"text":"凭据存成 docker-registry 类型的 Secret。","f":"eacceacdc7.mp3","h":"eacceacdc7","r":0},{"s":4,"a":5.4,"d":4.03,"text":"挂到默认 ServiceAccount，Pod 自动带上。","f":"951bfdb8d0.mp3","h":"951bfdb8d0","r":0},{"s":4,"a":9.6,"d":3.6,"text":"有缓存能跑，换个节点就报 401。","f":"091936ecbd.mp3","h":"091936ecbd","r":15},{"s":4,"a":13.4,"d":3.72,"text":"--docker-server 要和镜像主机名完全一致。","f":"4723a35744.mp3","h":"4723a35744","r":5},{"s":5,"a":0.6,"d":4.37,"text":"100 节点各拉 20GB，仓库要吐出 2TB。","f":"6957aaa34d.mp3","h":"6957aaa34d","r":7},{"s":5,"a":5.2,"d":3.74,"text":"Spegel 让节点之间互相分享已有的层。","f":"33cf4f231a.mp3","h":"33cf4f231a","r":0},{"s":5,"a":9.4,"d":3.38,"text":"Dragonfly 支持预热和任意文件。","f":"0cd17cfa4f.mp3","h":"0cd17cfa4f","r":0},{"s":5,"a":13,"d":3.19,"text":"两者部署其一，缺省选 Spegel。","f":"a492be504b.mp3","h":"a492be504b","r":0},{"s":6,"a":0.8,"d":4.3,"text":"小结：镜像链路上的每一环，都可以加速。","f":"77ce7efafd.mp3","h":"77ce7efafd","r":0},{"s":6,"a":5.6,"d":4.2,"text":"下一课，Day-2 运维：升级与 etcd 维护。","f":"6b7087af78.mp3","h":"6b7087af78","r":0}]
