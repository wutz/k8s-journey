[{"s":0,"a":3.2,"d":4.34,"text":"ConfigMap 与 Secret：让镜像和配置解耦。","f":"91fdcd61cf.mp3","h":"91fdcd61cf","r":0},{"s":1,"a":0.6,"d":4.13,"text":"配置打进镜像，每个环境就得一个镜像。","f":"4c13c9b681.mp3","h":"4c13c9b681","r":0},{"s":1,"a":5.6,"d":3.79,"text":"配置进 ConfigMap，密码进 Secret。","f":"e410b2f341.mp3","h":"e410b2f341","r":0},{"s":1,"a":10.8,"d":4.75,"text":"可以写 YAML 声明，也能从文件直接生成。","f":"1a64eeb9e2.mp3","h":"1a64eeb9e2","r":0},{"s":2,"a":0.6,"d":4.3,"text":"configMapKeyRef 取单个键，名字还能改。","f":"d08a1822d1.mp3","h":"d08a1822d1","r":0},{"s":2,"a":5.6,"d":4.87,"text":"envFrom 整个导入，可以加 CFG_ 前缀。","f":"a97c875fbe.mp3","h":"a97c875fbe","r":0},{"s":2,"a":10.8,"d":4.92,"text":"引用不存在又没 optional，容器起不来。","f":"38a0a42278.mp3","h":"38a0a42278","r":0},{"s":3,"a":0.6,"d":4.13,"text":"卷挂载时，每个键变成目录里的一个文件。","f":"71553d7301.mp3","h":"71553d7301","r":0},{"s":3,"a":5.6,"d":4.99,"text":"改配置后，kubelet 写新目录，再切换 ..data。","f":"24a1147ec2.mp3","h":"24a1147ec2","r":16},{"s":3,"a":10.8,"d":4.97,"text":"挂载会遮住原目录；subPath 不跟随更新。","f":"e38fb8dfc0.mp3","h":"e38fb8dfc0","r":0},{"s":4,"a":0.6,"d":4.22,"text":"改完 ConfigMap，三种注入方式表现不同。","f":"b7afacc57f.mp3","h":"b7afacc57f","r":0},{"s":4,"a":5.6,"d":4.54,"text":"卷挂载会更新，subPath 和 env 不会。","f":"ccc4cd2c9b.mp3","h":"ccc4cd2c9b","r":0},{"s":4,"a":10.6,"d":6.19,"text":"稳妥做法：滚动重启，或换个新名字。","f":"5f41149519.mp3","h":"5f41149519","r":0},{"s":5,"a":0.6,"d":4.78,"text":"Secret 用法和 ConfigMap 一样，值只是 base64。","f":"f9aa493cea.mp3","h":"f9aa493cea","r":19},{"s":5,"a":5.6,"d":3.62,"text":"谁能读这个对象，谁就能一键解码。","f":"f7fbf13cb5.mp3","h":"f7fbf13cb5","r":0},{"s":5,"a":10.8,"d":6.26,"text":"生产上：静态加密、最小权限、不进 Git。","f":"eac4453c82.mp3","h":"eac4453c82","r":12},{"s":6,"a":0.8,"d":4.13,"text":"小结：镜像不变，配置随环境注入。","f":"79a148e431.mp3","h":"79a148e431","r":0},{"s":6,"a":5.6,"d":3.48,"text":"下一课，健康检查与资源管理。","f":"ff5c75ec73.mp3","h":"ff5c75ec73","r":0}]
